local function exitCameraView()
	currentViewingCam = 0
	activeRotationDir = 0
	camControlFrame.Visible = false
	workspace.CurrentCamera.CameraSubject = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
	
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then hum.PlatformStand = false end
	
	for i = 1, MAX_CAMS do
		if camUIRows[i] and camUIRows[i].Visible then
			camUIRows[i].ViewBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
			camUIRows[i].ViewBtn.Text = camUIRows[i].CustomName
		end
	end
end

tpToCamBtn.MouseButton1Click:Connect(function()
	if currentViewingCam == 0 or not cameraData[currentViewingCam] then return end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		hrp.Anchored = true
		hrp.CFrame = cameraData[currentViewingCam].CFrame * CFrame.new(0, 3.5, 0)
		task.delay(0.15, function()
			if hrp then hrp.Anchored = false end
		end)
	end
	exitCameraView()
end)

local function ViewCamera(index)
	if currentViewingCam == index then
		exitCameraView()
		return
	end
	currentViewingCam = index
	activeRotationDir = 0
	for j = 1, MAX_CAMS do
		if camUIRows[j] and camUIRows[j].Visible then
			if j == index then
				camUIRows[j].ViewBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
				camUIRows[j].ViewBtn.Text = camUIRows[j].CustomName .. " (Đang xem)"
			else
				camUIRows[j].ViewBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
				camUIRows[j].ViewBtn.Text = camUIRows[j].CustomName
			end
		end
	end
	workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
	workspace.CurrentCamera.CFrame = cameraData[index].CFrame
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then hum.PlatformStand = true end
	updateSmallCamUI(index)
end

