		table.clear(removedSkyInstances)
		for _, v in pairs(lighting:GetChildren()) do if v:IsA("Sky") then table.insert(removedSkyInstances, v); v.Parent = nil end end
		table.clear(removedEffects)
		for _, v in pairs(workspace:GetDescendants()) do
			if v:IsA("Decal") or v:IsA("Texture") or v:IsA("SurfaceAppearance") or v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Beam") or v:IsA("PostEffect") then
