	if gameProcessed then return end
	if currentViewingCam > 0 and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
		local screenWidth = workspace.CurrentCamera.ViewportSize.X
		activeRotationDir = input.Position.X < screenWidth / 2 and 1 or -1
	end
end)

userInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		activeRotationDir = 0
	end
end)

runService.RenderStepped:Connect(function(dt)
	if currentViewingCam > 0 and cameraData[currentViewingCam] then
		workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
		if activeRotationDir ~= 0 then
			local cf = cameraData[currentViewingCam].CFrame
			local x, y, z = cf:ToOrientation()
			local rotSpeed = 35 * dt * activeRotationDir
			cameraData[currentViewingCam].CFrame = CFrame.new(cf.Position) * CFrame.fromOrientation(x, y + math.rad(rotSpeed), z)
		end
		workspace.CurrentCamera.CFrame = cameraData[currentViewingCam].CFrame
	end
end)

