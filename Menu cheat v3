-- Hàm tạo Button chuẩn
local function CreateButton(text, color, pos, size)
	local b = Instance.new("TextButton")
	b.Text = text
	b.BackgroundColor3 = color
	b.Position = pos
	b.Size = size
	b.TextScaled = true
	b.Font = Enum.Font.SourceSansBold
	b.TextColor3 = Color3.fromRGB(0, 0, 0)
	b.BorderSizePixel = 2
	b.Parent = mainFrame
	return b
end

