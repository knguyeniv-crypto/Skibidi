-- Fix Lag Nâng Cao Đầy Đủ
fixLagBtn.MouseButton1Click:Connect(function()
	fixLagOn = not fixLagOn
	if fixLagOn then
		fixLagBtn.Text = "Fix Lag: ON"
		fixLagBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
		
		oldGlobalShadows = lighting.GlobalShadows
		oldBrightness = lighting.Brightness
		oldFogEnd = lighting.FogEnd
		
		lighting.GlobalShadows = false
		lighting.Brightness = 1
		lighting.FogEnd = 9e9
		
		table.clear(removedSkyInstances)
		for _, v in pairs(lighting:GetChildren()) do
			if v:IsA("Sky") then
				table.insert(removedSkyInstances, v)
				v.Parent = nil
			end
		end
		
		table.clear(removedEffects)
		
		for _, v in pairs(workspace:GetDescendants()) do
			if v:IsA("Decal") or v:IsA("Texture") or v:IsA("SurfaceAppearance") or v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Beam") or v:IsA("PostEffect") then
				table.insert(removedEffects, {Instance = v, Parent = v.Parent})
				v.Parent = nil
			elseif v:IsA("BasePart") and v ~= terrain then
				if not originalPartData[v] then
					originalPartData[v] = {
						Material = v.Material,
						Color = v.Color,
						Reflectance = v.Reflectance,
						CastShadow = v.CastShadow
					}
				end
				v.Material = Enum.Material.SmoothPlastic
				v.Reflectance = 0
				v.CastShadow = false
				v.Color = BLOCK_COLOR
			end
		end
		
		table.clear(disabledAnimateScripts)
		local function ProcessCharacterAnimation(char)
			local animate = char:FindFirstChild("Animate")
			if animate and animate:IsA("LocalScript") and animate.Enabled then
				animate.Enabled = false
				table.insert(disabledAnimateScripts, animate)
			end
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			if humanoid then
				for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do
					track:Stop()
				end
			end
		end

		if player.Character then
			ProcessCharacterAnimation(player.Character)
			myCharConnection = player.Character.DescendantAdded:Connect(function(v)
				if v.Name == "Animate" and v:IsA("LocalScript") then
					v.Enabled = false
					table.insert(disabledAnimateScripts, v)
				end
			end)
		end
		
		animFastConnection = runService.RenderStepped:Connect(function()
			local char = player.Character
			if char then
				local animate = char:FindFirstChild("Animate")
				if animate and animate:IsA("LocalScript") and animate.Enabled then
					animate.Enabled = false
					table.insert(disabledAnimateScripts, animate)
				end
				local humanoid = char:FindFirstChildOfClass("Humanoid")
				if humanoid then
					for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do
						track:Stop()
					end
				end
			end
		end)
		
		fixLagConnection = workspace.DescendantAdded:Connect(function(v)
			task.spawn(function()
				if v:IsA("Decal") or v:IsA("Texture") or v:IsA("SurfaceAppearance") or v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Beam") or v:IsA("PostEffect") then
					table.insert(removedEffects, {Instance = v, Parent = v.Parent})
					v.Parent = nil
				elseif v:IsA("BasePart") and v ~= terrain and not originalPartData[v] then
					originalPartData[v] = {
						Material = v.Material,
						Color = v.Color,
						Reflectance = v.Reflectance,
						CastShadow = v.CastShadow
					}
					v.Material = Enum.Material.SmoothPlastic
					v.Reflectance = 0
					v.CastShadow = false
					v.Color = BLOCK_COLOR
				end
			end)
		end)
	else
		fixLagBtn.Text = "Fix Lag: OFF"
		fixLagBtn.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
		
		if animFastConnection then
			animFastConnection:Disconnect()
			animFastConnection = nil
		end
		if fixLagConnection then
			fixLagConnection:Disconnect()
			fixLagConnection = nil
		end
		if myCharConnection then
			myCharConnection:Disconnect()
			myCharConnection = nil
		end
		
		lighting.GlobalShadows = oldGlobalShadows
		lighting.Brightness = oldBrightness
		lighting.FogEnd = oldFogEnd
		for _, sky in ipairs(removedSkyInstances) do
			sky.Parent = lighting
		end
		
		for _, data in ipairs(removedEffects) do
			if data.Instance and data.Parent then
				data.Instance.Parent = data.Parent
			end
		end
		table.clear(removedEffects)
		
		for part, data in pairs(originalPartData) do
			if part and part.Parent then
				part.Material = data.Material
				part.Color = data.Color
				part.Reflectance = data.Reflectance
				part.CastShadow = data.CastShadow
			end
		end
		table.clear(originalPartData)

		for _, scriptObj in ipairs(disabledAnimateScripts) do
			if scriptObj and scriptObj.Parent then
				scriptObj.Enabled = true
			end
		end
		table.clear(disabledAnimateScripts)
		
		if player.Character then
			local animate = player.Character:FindFirstChild("Animate")
			if animate and animate:IsA("LocalScript") then
				animate.Enabled = true
			end
		end
	end
end)

-- Tốc độ & Fly
plusBtn.MouseButton1Click:Connect(function()
	speed += 1
	speedLabel.Text = "Speed: " .. tostring(speed)
end)

minusBtn.MouseButton1Click:Connect(function()
	speed = math.max(1, speed - 1)
	speedLabel.Text = "Speed: " .. tostring(speed)
end)

upBtn.MouseButton1Down:Connect(function() vertical = 1 end)
upBtn.MouseButton1Up:Connect(function() vertical = 0 end)
downBtn.MouseButton1Down:Connect(function() vertical = -1 end)
downBtn.MouseButton1Up:Connect(function() vertical = 0 end)

flyBtn.MouseButton1Click:Connect(function()
	flying = not flying
	local char = player.Character
	local humanoid = char and char:WaitForChild("Humanoid")
	local hrp = char and char:WaitForChild("HumanoidRootPart")
	
	if flying then
		flyBtn.Text = "UNFLY"
		flyBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
		if hrp then
			bv = Instance.new("BodyVelocity")
			bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
			bv.Velocity = Vector3.zero
			bv.Parent = hrp
			bg = Instance.new("BodyGyro")
			bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
			bg.P = 10000
			bg.Parent = hrp
		end
		if humanoid then humanoid.PlatformStand = true end
	else
		flyBtn.Text = "FLY"
		flyBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
		if bv then bv:Destroy() end
		if bg then bg:Destroy() end
		if humanoid then humanoid.PlatformStand = false end
	end
end)

runService.RenderStepped:Connect(function()
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local humanoid = char and char:FindFirstChild("Humanoid")
	
	if flying and hrp and humanoid and bv and bg then
		local cam = workspace.CurrentCamera
		local move = humanoid.MoveDirection
		local localMove = hrp.CFrame:VectorToObjectSpace(move)
		local velocity =
			(hrp.CFrame.LookVector * -localMove.Z) +
			(hrp.CFrame.RightVector * localMove.X)
		velocity += Vector3.new(0, vertical, 0)
		if velocity.Magnitude > 0 then velocity = velocity.Unit end
		bv.Velocity = velocity * (speed * 20)
		bg.CFrame = cam.CFrame
	end
end)
