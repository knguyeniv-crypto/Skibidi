-- Hàm tạo Button chuẩn (Dùng TextSize thuần thay vì TextScaled để tự căn kích thước chữ không bị bẹt)
local function CreateButton(text, color, pos, size, textSize)
	local b = Instance.new("TextButton")
	b.Text = text
	b.BackgroundColor3 = color
	b.Position = pos
	b.Size = size
	b.TextSize = textSize or 14
	b.Font = Enum.Font.SourceSansBold
	b.TextColor3 = Color3.fromRGB(0, 0, 0)
	b.BorderSizePixel = 2
	b.Parent = mainFrame
	return b
end

