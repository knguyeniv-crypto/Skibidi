-- ==================== ESP ====================
local espOn = false
local espObjects = {}
local function createESP(plr)
	if plr == player or espObjects[plr] then return end
	local hl = Instance.new("Highlight")
	hl.FillColor = Color3.fromRGB(255,0,0); hl.FillTransparency = 0.5; hl.OutlineTransparency = 0
	local bill = Instance.new("BillboardGui")
	bill.Size = UDim2.new(0,200,0,50); bill.AlwaysOnTop = true
	local txt = Instance.new("TextLabel", bill)
	txt.Size = UDim2.new(1,0,1,0); txt.BackgroundTransparency = 1
	txt.TextSize = 13; txt.Font = Enum.Font.SourceSansBold; txt.TextColor3 = Color3.fromRGB(0,255,0); txt.TextStrokeTransparency = 0
	espObjects[plr] = {Highlight = hl, Billboard = bill, Label = txt}
end

local function removeESP(plr)
	if espObjects[plr] then
		if espObjects[plr].Highlight then espObjects[plr].Highlight:Destroy() end
		if espObjects[plr].Billboard then espObjects[plr].Billboard:Destroy() end
		espObjects[plr] = nil
	end
end

espBtn.MouseButton1Click:Connect(function()
	espOn = not espOn
	if espOn then
		espBtn.Text = "ESP: ON"; espBtn.BackgroundColor3 = Color3.fromRGB(0,200,0)
		for _, p in pairs(players:GetPlayers()) do createESP(p) end
	else
		espBtn.Text = "ESP: OFF"; espBtn.BackgroundColor3 = Color3.fromRGB(255,80,80)
		for p, _ in pairs(espObjects) do removeESP(p) end
	end
end)

runService.RenderStepped:Connect(function()
	if not espOn then return end
	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	for plr, obj in pairs(espObjects) do
		local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
		if root and myRoot then
			if obj.Highlight.Parent ~= plr.Character then obj.Highlight.Parent = plr.Character end
			if obj.Billboard.Parent ~= root then obj.Billboard.Parent = root end
			local dist = math.floor((myRoot.Position - root.Position).Magnitude)
			obj.Label.Text = plr.Name .. "\n[" .. dist .. " bước]"
		else
			if obj.Highlight.Parent then obj.Highlight.Parent = nil end
			if obj.Billboard.Parent then obj.Billboard.Parent = nil end
		end
	end
end)
players.PlayerAdded:Connect(function(p) if espOn then createESP(p) end end)
players.PlayerRemoving:Connect(removeESP)

