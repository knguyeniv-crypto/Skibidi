-- ==================== FIX LAG (KHÔNG ĐỤNG ANIMATION) ====================
local fixLagOn = false
fixLagBtn.MouseButton1Click:Connect(function()
	fixLagOn = not fixLagOn
	if fixLagOn then
		fixLagBtn.Text = "Fix Lag: ON"
		fixLagBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
		
		oldGlobalShadows = lighting.GlobalShadows
		oldBrightness = lighting.Brightness
		oldFogEnd = lighting.FogEnd
		
		lighting.GlobalShadows = false
		lighting.Brightness = 1
		lighting.FogEnd = 9e9
		
		table.clear(removedSkyInstances)
		for _, v in pairs(lighting:GetChildren()) do
			if v:IsA("Sky") then
				table.insert(removedSkyInstances, v)
				v.Parent = nil
			end
		end
		
		table.clear(removedEffects)
		
		for _, v in pairs(workspace:GetDescendants()) do
			if v:IsA("Decal") or v:IsA("Texture") or v:IsA("SurfaceAppearance") or v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Beam") or v:IsA("PostEffect") then
				table.insert(removedEffects, {Instance = v, Parent = v.Parent})
				v.Parent = nil
			elseif v:IsA("BasePart") and v ~= terrain then
				if not originalPartData[v] then
					originalPartData[v] = {
						Material = v.Material,
						Color = v.Color,
						Reflectance = v.Reflectance,
						CastShadow = v.CastShadow
					}
				end
				v.Material = Enum.Material.SmoothPlastic
				v.Reflectance = 0
				v.CastShadow = false
				v.Color = BLOCK_COLOR
			end
		end
		
		fixLagConnection = workspace.DescendantAdded:Connect(function(v)
			task.spawn(function()
				if v:IsA("Decal") or v:IsA("Texture") or v:IsA("SurfaceAppearance") or v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Beam") or v:IsA("PostEffect") then
					table.insert(removedEffects, {Instance = v, Parent = v.Parent})
					v.Parent = nil
				elseif v:IsA("BasePart") and v ~= terrain and not originalPartData[v] then
					originalPartData[v] = {
						Material = v.Material,
						Color = v.Color,
						Reflectance = v.Reflectance,
						CastShadow = v.CastShadow
					}
					v.Material = Enum.Material.SmoothPlastic
					v.Reflectance = 0
					v.CastShadow = false
					v.Color = BLOCK_COLOR
				end
			end)
		end)
	else
		fixLagBtn.Text = "Fix Lag: OFF"
		fixLagBtn.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
		
		if fixLagConnection then fixLagConnection:Disconnect(); fixLagConnection = nil end
		
		lighting.GlobalShadows = oldGlobalShadows
		lighting.Brightness = oldBrightness
		lighting.FogEnd = oldFogEnd
		for _, sky in ipairs(removedSkyInstances) do sky.Parent = lighting end
		
		for _, data in ipairs(removedEffects) do
			if data.Instance and data.Parent then data.Instance.Parent = data.Parent end
		end
		table.clear(removedEffects)
		
		for part, data in pairs(originalPartData) do
			if part and part.Parent then
				part.Material = data.Material
				part.Color = data.Color
				part.Reflectance = data.Reflectance
				part.CastShadow = data.CastShadow
			end
		end
		table.clear(originalPartData)
	end
end)

