runService.Heartbeat:Connect(function()
	local h = player.Character and player.Character:FindFirstChild("Humanoid")
	if h then
		if wsOn then h.WalkSpeed = wsVal end
		if jpOn then h.UseJumpPower = true; h.JumpPower = jpVal end
	end
end)

-- ==================== FLY ====================
local flying, speed, vertical = false, 1, 0
plusBtn.MouseButton1Click:Connect(function() speed += 1; speedLbl.Text = "Fly Spd: "..speed end)
minusBtn.MouseButton1Click:Connect(function() speed = math.max(1,speed-1); speedLbl.Text = "Fly Spd: "..speed end)
upBtn.MouseButton1Down:Connect(function() vertical = 1 end); upBtn.MouseButton1Up:Connect(function() vertical = 0 end)
downBtn.MouseButton1Down:Connect(function() vertical = -1 end); downBtn.MouseButton1Up:Connect(function() vertical = 0 end)

local bv, bg
flyBtn.MouseButton1Click:Connect(function()
	flying = not flying
	flyBtn.Text = flying and "UNFLY" or "FLY"
	flyBtn.BackgroundColor3 = flying and Color3.fromRGB(0,200,0) or Color3.fromRGB(255,255,0)
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local h = player.Character and player.Character:FindFirstChild("Humanoid")
	if flying and hrp then
		bv = Instance.new("BodyVelocity", hrp); bv.MaxForce = Vector3.new(math.huge,math.huge,math.huge); bv.Velocity = Vector3.zero
		bg = Instance.new("BodyGyro", hrp); bg.MaxTorque = Vector3.new(math.huge,math.huge,math.huge); bg.P = 10000
		if h then h.PlatformStand = true end
	else
		if bv then bv:Destroy() end; if bg then bg:Destroy() end
		if h then h.PlatformStand = false end
	end
end)

runService.RenderStepped:Connect(function()
	if flying and bv and bg and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
		local hrp, h = player.Character.HumanoidRootPart, player.Character.Humanoid
		local move = hrp.CFrame:VectorToObjectSpace(h.MoveDirection)
		local vel = (hrp.CFrame.LookVector * -move.Z) + (hrp.CFrame.RightVector * move.X) + Vector3.new(0,vertical,0)
		bv.Velocity = (vel.Magnitude>0 and vel.Unit or vel) * (speed * 20)
		bg.CFrame = workspace.CurrentCamera.CFrame
	end
end)
